# Example environment file - Copy to .env and add your actual keys
# NEVER commit the actual .env file to git!

# OpenAI (Strategy generation, education)
OPENAI_API_KEY=your-openai-key-here

# Anthropic / Claude (Optional fallback)
CLAUDE_API_KEY=your-claude-key-here

# Polygon (Market data)
POLYGON_API_KEY=your-polygon-key-here

# Alpaca (Stock trading execution)
APCA_API_KEY_ID=your-alpaca-key-here
APCA_API_SECRET_KEY=your-alpaca-secret-here
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here